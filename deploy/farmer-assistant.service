[Unit]
Description=FarmHerd farmer assistant UI
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/farmer_chat
Environment=AWS_REGION=ap-south-1
ExecStart=/home/ubuntu/farmer_chat/.venv/bin/streamlit run app.py --server.address 127.0.0.1 --server.port 8502 --server.baseUrlPath assistant --server.headless true --server.enableCORS false --server.enableXsrfProtection true
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
