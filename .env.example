# Local dev environment template for FarmHerd. Copy to .env (gitignored,
# never committed) and fill in your own values.
#
#   cp .env.example .env
#
# Never put real credentials in this file — this one IS committed to git.

# --- Required (utils/env_check.py hard-fails startup without these) ---
# Your own AWS IAM user's credentials, with Bedrock/Transcribe/Polly/S3
# access in the region below. Get these from your own ~/.aws/credentials
# or the AWS console — never copy someone else's.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
# S3 bucket for voice audio uploads (batch Transcribe mode). Ask a team
# member for the shared dev bucket name, or create your own.
VOICE_BUCKET=
# transcribe.py's batch-mode upload path actually reads VOICE_S3_BUCKET,
# not VOICE_BUCKET (pre-existing naming inconsistency) — set both to the
# same bucket so neither code path 404s.
VOICE_S3_BUCKET=

# --- STT/TTS provider selection (config/llm.yaml has the same knobs; env wins) ---
STT_PROVIDER=aws-transcribe-streaming
TTS_PROVIDER=aws-polly
TTS_FALLBACK_PROVIDER=gtts

# --- CORS (defaults to "*" in code if unset; set explicitly for local dev) ---
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# --- API-key gate on the voice/chat endpoints (unset = no gate, local-dev default) ---
# FARMER_CHAT_API_KEY=

# --- flokiq integration (off by default — leave disabled unless testing it) ---
FLOKIQ_SYNC_ENABLED=false
# FLOKIQ_API_BASE_URL=http://localhost:8077
# FLOKIQ_API_TOKEN=

# --- Local data dir override (leave unset to use ./data) ---
# FARMER_CHAT_DATA_DIR=

# --- Voice session storage (leave unset for disk-backed default) ---
# VOICE_SESSIONS_MEMORY=1

# --- ADK-native orchestration layer (off by default -- opt-in while the
# migration in /Users/sudhanshu/.claude/plans/elegant-roaming-river.md is
# being verified equivalent to the existing chat_orchestrator/router.py
# path; requires google-adk[extensions], which needs Python 3.10+) ---
# CHAT_ORCHESTRATOR_ADK=1

# --- Optional LLM fallback: route to any OpenAI-compatible endpoint
# (freellmapi local router, direct Groq, direct Gemini, LM Studio,
# Ollama, ...) instead of AWS Bedrock. Personal-dev-only escape hatch
# for when the AWS account can't reach Bedrock. NOT for the shared demo
# backend or production -- the upstream free providers' ToS universally
# forbid serving other users' traffic. Every code path stays untouched;
# BedrockTextAdapter.complete / converse_with_tool AND the ADK agents
# (router, query, weather) re-route when LLM_PROVIDER=freellmapi is set.
#
# Two common shapes:
# (a) via a local freellmapi router (aggregates 34 providers):
#   FREELLM_BASE_URL=http://localhost:3001/v1
#   FREELLM_API_KEY=freellmapi-...
#   FREELLM_MODEL=auto
# (b) direct to Groq (fastest, no router needed -- Groq is OpenAI-compat):
#   FREELLM_BASE_URL=https://api.groq.com/openai/v1
#   FREELLM_API_KEY=gsk_...
#   FREELLM_MODEL=openai/gpt-oss-120b
# LLM_PROVIDER=freellmapi
# FREELLM_BASE_URL=https://api.groq.com/openai/v1
# FREELLM_API_KEY=
# FREELLM_MODEL=openai/gpt-oss-120b
# FREELLM_MODEL_EXTRACTION=openai/gpt-oss-120b   # optional per-task pin
# FREELLM_MODEL_GENERATION=
# FREELLM_MODEL_LONG_FORM=
# FREELLM_EXTRA_BODY={"include_reasoning": false, "reasoning_effort": "low"}   # Groq gpt-oss: required for tool calls within the extraction token budget

# --- ADK agent sessions (query agent chat memory) ---
# Unset = in-memory: each chat session keeps its history until the server
# restarts. Set to a SQLAlchemy URL to keep it across restarts, e.g.
# ADK_SESSION_DB_URL=sqlite+aiosqlite:///./data/adk_sessions.db

# --- WhatsApp channel ---
# Off by default; nothing changes for existing deployments until set.
# Reference: docs/13-whatsapp-channel.md. Config file (with the same
# knobs env can override) lives at config/channels.yaml.
# WHATSAPP_ENABLED=1
# WHATSAPP_PROVIDER=meta                        # meta|twilio|mock
# WHATSAPP_ALLOWED_INTENTS=query,appointment    # subset of {query,appointment,weather,add_animal}
# WHATSAPP_DEFAULT_LANGUAGE=en-IN               # only used for script-neutral messages
# WHATSAPP_INCLUDE_AUDIO=0                      # 1 to also send voice-note replies (adds Polly cost)
# WHATSAPP_MAX_REPLY_CHARS=4000
# WHATSAPP_RATE_LIMIT_PER_MIN=6
# WHATSAPP_RATE_LIMIT_PER_HOUR=100
# WHATSAPP_ENROLLMENT_ENABLED=1
# --- Provider secrets (only the one you use) ---
# Meta Cloud API:
# WHATSAPP_META_PHONE_ID=
# WHATSAPP_META_ACCESS_TOKEN=
# WHATSAPP_META_APP_SECRET=
# WHATSAPP_META_VERIFY_TOKEN=                   # a string YOU pick; matches Meta's webhook verify_token
# Twilio (WORKING SKELETON: verify_signature + send_text; media not yet impl):
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Exact public URL Twilio POSTs to (as set in the Twilio console), e.g.
# https://api.example.com/whatsapp/webhook. Needed when the server runs
# behind a proxy/load balancer; otherwise X-Forwarded-* headers are used.
# WHATSAPP_PUBLIC_URL=

# WhatsApp enrollment OTP: an unknown WhatsApp number is linked to a farmer
# only after it sends back a 6-digit code SMSed to the farmer's registered
# phone. Unset = enrollment refused. "mock" = dev only (code in server logs).
# WHATSAPP_OTP_PROVIDER=msg91
# Same MSG91 key as main_backend:
# MSG91_AUTH_KEY=
# DLT-approved OTP template, and the template variable that holds the code:
# WHATSAPP_MSG91_OTP_TEMPLATE_ID=
# WHATSAPP_MSG91_OTP_VAR=var1