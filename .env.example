# Local dev environment template for FarmHerd. Copy to .env (gitignored,
# never committed) and fill in your own values.
#
#   cp .env.example .env
#
# Never put real credentials in this file — this one IS committed to git.

# --- Required (utils/env_check.py hard-fails startup without these) ---
# Your own AWS IAM user's credentials, with Bedrock/Transcribe/Polly/S3
# access in the region below. Get these from your own ~/.aws/credentials
# or the AWS console — never copy someone else's.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
# S3 bucket for voice audio uploads (batch Transcribe mode). Ask a team
# member for the shared dev bucket name, or create your own.
VOICE_BUCKET=
# transcribe.py's batch-mode upload path actually reads VOICE_S3_BUCKET,
# not VOICE_BUCKET (pre-existing naming inconsistency) — set both to the
# same bucket so neither code path 404s.
VOICE_S3_BUCKET=

# --- STT/TTS provider selection (config/llm.yaml has the same knobs; env wins) ---
STT_PROVIDER=aws-transcribe-streaming
TTS_PROVIDER=aws-polly
TTS_FALLBACK_PROVIDER=gtts

# --- CORS (defaults to "*" in code if unset; set explicitly for local dev) ---
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# --- API-key gate on the voice/chat endpoints (unset = no gate, local-dev default) ---
# FARMER_CHAT_API_KEY=

# --- flokiq integration (off by default — leave disabled unless testing it) ---
FLOKIQ_SYNC_ENABLED=false
# FLOKIQ_API_BASE_URL=http://localhost:8077
# FLOKIQ_API_TOKEN=

# --- Local data dir override (leave unset to use ./data) ---
# FARMER_CHAT_DATA_DIR=

# --- Voice session storage (leave unset for disk-backed default) ---
# VOICE_SESSIONS_MEMORY=1

# --- ADK-native orchestration layer (off by default -- opt-in while the
# migration in /Users/sudhanshu/.claude/plans/elegant-roaming-river.md is
# being verified equivalent to the existing chat_orchestrator/router.py
# path; requires google-adk[extensions], which needs Python 3.10+) ---
# CHAT_ORCHESTRATOR_ADK=1

# --- Optional LLM fallback: route to a local OpenAI-compatible endpoint
# (e.g. freellmapi) instead of AWS Bedrock. Personal-dev-only escape
# hatch for when the AWS account can't reach Bedrock. NOT for the
# shared demo backend or production -- the upstream free providers'
# ToS universally forbid serving other users' traffic. Every code
# path stays untouched; only BedrockTextAdapter.complete/
# converse_with_tool re-route when LLM_PROVIDER=freellmapi is set.
# LLM_PROVIDER=freellmapi
# FREELLM_BASE_URL=http://localhost:3001/v1
# FREELLM_API_KEY=
# FREELLM_MODEL=auto                # router-picked (default)
# FREELLM_MODEL_EXTRACTION=llama-3.3-70b   # optional per-task pin
# FREELLM_MODEL_GENERATION=
# FREELLM_MODEL_LONG_FORM=
